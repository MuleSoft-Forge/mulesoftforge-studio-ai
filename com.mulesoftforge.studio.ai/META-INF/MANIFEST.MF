Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: MuleSoftForge Studio AI
Bundle-SymbolicName: com.mulesoftforge.studio.ai;singleton:=true
Bundle-Version: 0.4.0.qualifier
Bundle-Activator: com.mulesoftforge.studio.ai.Activator
Bundle-Vendor: MuleSoftForge
Require-Bundle: org.eclipse.ui,
 org.eclipse.core.runtime,
 org.eclipse.core.resources,
 org.eclipse.ui.ide,
 org.eclipse.ui.console,
 org.eclipse.jface.text,
 org.eclipse.ui.workbench.texteditor,
 org.eclipse.equinox.security,
 org.eclipse.compare
Bundle-RequiredExecutionEnvironment: JavaSE-17
Automatic-Module-Name: com.mulesoftforge.studio.ai
Bundle-ActivationPolicy: lazy
Bundle-ClassPath: .,
 lib/langchain4j-core.jar,
 lib/langchain4j-http-client.jar,
 lib/langchain4j-http-client-jdk.jar,
 lib/langchain4j-open-ai.jar,
 lib/langchain4j-anthropic.jar,
 lib/langchain4j-ollama.jar,
 lib/langchain4j-reactive-streaming.jar,
 lib/mutiny-zero.jar,
 lib/jtokkit.jar,
 lib/jackson-annotations.jar,
 lib/jackson-core.jar,
 lib/jackson-databind.jar,
 lib/jspecify.jar,
 lib/slf4j-api.jar
